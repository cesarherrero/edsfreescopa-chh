          {
            "name": "Image and text (Imagen derecha / izquierda)",
            "value": "image"
          },
          {
            "name": "Image centred on the right (Imagen centrado derecha)",
            "value": "centered"
          },
          {
            "name": "Video and text, or video gallery (Vídeo texto / Vídeo galería)",
            "value": "video"
          },
          {
            "name": "Video for distributor pages (Vídeo distribuidora)",
            "value": "video-dist"
          },
