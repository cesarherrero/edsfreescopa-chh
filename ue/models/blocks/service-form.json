{
  "definitions": [
    {
      "title": "Service Form",
      "id": "service-form",
      "model": "service-form",
      "filter": "service-form",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"service-form columns-1\"><div><div>action</div><div></div></div><div><div>method</div><div>POST</div></div><div><div>submit</div><div>Enviar</div></div><div><div>success</div><div></div></div><div><div>error</div><div></div></div></div>",
          "fields": [
            { "name": "action", "selector": "div:nth-child(1)>div:nth-child(2)" },
            { "name": "method", "selector": "div:nth-child(2)>div:nth-child(2)" },
            { "name": "submit", "selector": "div:nth-child(3)>div:nth-child(2)" },
            { "name": "success", "selector": "div:nth-child(4)>div:nth-child(2)" },
            { "name": "error", "selector": "div:nth-child(5)>div:nth-child(2)" }
          ]
        }
      }
    },
    {
      "title": "Input Text",
      "id": "input-text",
      "model": "input-text",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 8,
          "fields": [
            { "name": "type", "selector": "div:nth-child(1)" },
            { "name": "name", "selector": "div:nth-child(2)" },
            { "name": "label", "selector": "div:nth-child(3)" },
            { "name": "placeholder", "selector": "div:nth-child(4)" },
            { "name": "required", "selector": "div:nth-child(5)" },
            { "name": "pattern", "selector": "div:nth-child(6)" },
            { "name": "requiredMessage", "selector": "div:nth-child(7)" },
            { "name": "validationMessage", "selector": "div:nth-child(8)" }
          ]
        }
      }
    },
    {
      "title": "Input Options",
      "id": "input-options",
      "model": "input-options",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 7,
          "fields": [
            { "name": "type", "selector": "div:nth-child(1)" },
            { "name": "name", "selector": "div:nth-child(2)" },
            { "name": "label", "selector": "div:nth-child(3)" },
            { "name": "placeholder", "selector": "div:nth-child(4)" },
            { "name": "options", "selector": "div:nth-child(5)" },
            { "name": "required", "selector": "div:nth-child(6)" },
            { "name": "errorMessage", "selector": "div:nth-child(7)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "service-form",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "action",
          "label": "Service URL (endpoint)",
          "required": true
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "method",
          "label": "HTTP method",
          "value": "POST",
          "options": [
            { "name": "POST", "value": "POST" },
            { "name": "PUT", "value": "PUT" },
            { "name": "GET", "value": "GET" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Columns",
          "value": "columns-1",
          "options": [
            { "name": "1 column", "value": "columns-1" },
            { "name": "2 columns", "value": "columns-2" },
            { "name": "3 columns", "value": "columns-3" },
            { "name": "4 columns", "value": "columns-4" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submit",
          "label": "Submit button text",
          "value": "Enviar"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "success",
          "label": "Success message"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "error",
          "label": "Service error message"
        }
      ]
    },
    {
      "id": "input-text",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field type",
          "value": "text",
          "required": true,
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Phone", "value": "tel" },
            { "name": "Number", "value": "number" },
            { "name": "URL", "value": "url" },
            { "name": "Date", "value": "date" },
            { "name": "Password", "value": "password" },
            { "name": "Textarea", "value": "textarea" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "name",
          "label": "Field name (sent to the service)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "placeholder",
          "label": "Placeholder"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "required",
          "label": "Required"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "pattern",
          "label": "Validation pattern (regex)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "requiredMessage",
          "label": "Required error message"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "validationMessage",
          "label": "Validation error message"
        }
      ]
    },
    {
      "id": "input-options",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field type",
          "value": "checkbox",
          "required": true,
          "options": [
            { "name": "Checkbox", "value": "checkbox" },
            { "name": "Radio button", "value": "radio" },
            { "name": "Switch", "value": "switch" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "name",
          "label": "Field name (sent to the service)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "placeholder",
          "label": "Placeholder / help text"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "options",
          "label": "Options (one per line: value|Text). Empty = single toggle"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "required",
          "label": "Required"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "errorMessage",
          "label": "Required error message"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "service-form",
      "components": ["input-text", "input-options"]
    }
  ]
}
